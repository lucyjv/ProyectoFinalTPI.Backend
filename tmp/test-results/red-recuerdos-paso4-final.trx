      SELECT t."Id", t."CodigoError", t."Estado", t."FechaActualizacion", t."FechaCreacion", t."Intentos", t."ProximoIntento", t."PublicacionId", t."ReservadoHasta", t."TokenReserva", t."VersionAnalizador", t."VersionContenido"&#xD;
