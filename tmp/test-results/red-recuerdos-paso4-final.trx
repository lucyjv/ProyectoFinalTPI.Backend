      CREATE TABLE trabajos_analisis_recuerdos (&#xD;
          "Id" bigint GENERATED BY DEFAULT AS IDENTITY,&#xD;
          "PublicacionId" integer NOT NULL,&#xD;
          "VersionContenido" bigint NOT NULL,&#xD;
          "Estado" integer NOT NULL,&#xD;
          "Intentos" integer NOT NULL,&#xD;
          "FechaCreacion" timestamp with time zone NOT NULL,&#xD;
          "FechaActualizacion" timestamp with time zone NOT NULL,&#xD;
          "ProximoIntento" timestamp with time zone NOT NULL,&#xD;
          "TokenReserva" uuid,&#xD;
          "ReservadoHasta" timestamp with time zone,&#xD;
          "CodigoError" character varying(50),&#xD;
          "VersionAnalizador" character varying(100),&#xD;
          CONSTRAINT "PK_trabajos_analisis_recuerdos" PRIMARY KEY ("Id"),&#xD;
          CONSTRAINT "CK_trabajos_analisis_estado" CHECK ("Estado" BETWEEN 0 AND 6),&#xD;
          CONSTRAINT "CK_trabajos_analisis_intentos" CHECK ("Intentos" &gt;= 0 AND "VersionContenido" &gt; 0),&#xD;
          CONSTRAINT "CK_trabajos_analisis_reserva" CHECK (("Estado" = 1 AND "TokenReserva" IS NOT NULL AND "ReservadoHasta" IS NOT NULL) OR ("Estado" &lt;&gt; 1 AND "TokenReserva" IS NULL AND "ReservadoHasta" IS NULL)),&#xD;
          CONSTRAINT "FK_trabajos_analisis_recuerdos_Publicaciones_PublicacionId" FOREIGN KEY ("PublicacionId") REFERENCES "Publicaciones" ("Id") ON DELETE CASCADE&#xD;
      );&#xD;
