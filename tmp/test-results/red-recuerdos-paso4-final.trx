      ) AS s&#xD;
      LEFT JOIN momentos AS m1 ON s."Id" = m1."MomentoPadreId"&#xD;
      LEFT JOIN momentos_alias AS m2 ON s."Id" = m2."MomentoId"&#xD;
      ORDER BY s."Id", s."Id0", m1."Id"&#xD;
