info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (4ms) [Parameters=[p0='?' (DbType = Int32), p1='?' (DbType = DateTime), p2='?' (DbType = DateTime), p3='?' (DbType = Guid), p4='?' (DbType = DateTime), p5='?' (DbType = DateTime)], CommandType='Text', CommandTimeout='30']&#xD;
      WITH candidato AS (&#xD;
          SELECT "Id" FROM trabajos_analisis_recuerdos&#xD;
          WHERE "Intentos" &lt; @p0 AND&#xD;
              (("Estado" = 0 AND "ProximoIntento" &lt;= @p1) OR ("Estado" = 1 AND "ReservadoHasta" &lt;= @p2))&#xD;
          ORDER BY "FechaCreacion", "Id"&#xD;
          FOR UPDATE SKIP LOCKED LIMIT 1&#xD;
      )&#xD;
      UPDATE trabajos_analisis_recuerdos j&#xD;
      SET "Estado" = 1, "Intentos" = j."Intentos" + 1, "TokenReserva" = @p3,&#xD;
          "ReservadoHasta" = @p4, "FechaActualizacion" = @p5&#xD;
      FROM candidato c WHERE j."Id" = c."Id"&#xD;
      RETURNING j."Id", j."PublicacionId", j."VersionContenido", j."Intentos", j."TokenReserva", j."ReservadoHasta"&#xD;
