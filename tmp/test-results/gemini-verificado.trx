      UPDATE trabajos_analisis_recuerdos SET "Estado" = 5, "TokenReserva" = NULL,&#xD;
    "ReservadoHasta" = NULL, "CodigoError" = 'reintentos_agotados', "FechaActualizacion" = @p0&#xD;
WHERE "Intentos" &gt;= @p1 AND&#xD;
    ("Estado" = 0 OR ("Estado" = 1 AND "ReservadoHasta" &lt;= @p2))&#xD;
