        FOREACH tabla IN ARRAY ARRAY['Usuario', 'Publicacion', 'Comentario', 'Lugar', 'Moderacion'] LOOP&#xD;
            IF to_regclass(format('public.%I', tabla)) IS NULL THEN&#xD;
