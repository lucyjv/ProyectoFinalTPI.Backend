ALTER TABLE "Publicaciones" ADD CONSTRAINT "FK_Publicaciones_Usuario_UsuarioId"&#xD;
    FOREIGN KEY ("UsuarioId") REFERENCES "Usuario" ("Id") ON DELETE CASCADE;&#xD;
