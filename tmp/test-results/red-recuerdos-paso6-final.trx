          CONSTRAINT "PK_publicaciones_momentos" PRIMARY KEY ("PublicacionId", "MomentoId"),&#xD;
          CONSTRAINT "CK_publicaciones_momentos_confianza" CHECK ("Confianza" IS NULL OR ("Confianza" &gt;= 0 AND "Confianza" &lt;= 1)),&#xD;
          CONSTRAINT "CK_publicaciones_momentos_estado" CHECK ("Estado" IN (0, 1)),&#xD;
          CONSTRAINT "CK_publicaciones_momentos_origen" CHECK ("Origen" IN (0, 1)),&#xD;
