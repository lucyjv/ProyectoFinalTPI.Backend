      CREATE TABLE mensajes_chat (&#xD;
          "Id" integer GENERATED BY DEFAULT AS IDENTITY,&#xD;
          "EmisorId" integer NOT NULL,&#xD;
          "DestinatarioId" integer NOT NULL,&#xD;
          "Contenido" character varying(2000) NOT NULL,&#xD;
          "FechaEnvio" timestamp with time zone NOT NULL,&#xD;
          "FechaExpiracion" timestamp with time zone NOT NULL,&#xD;
          CONSTRAINT "PK_mensajes_chat" PRIMARY KEY ("Id"),&#xD;
          CONSTRAINT "FK_mensajes_chat_Usuario_DestinatarioId" FOREIGN KEY ("DestinatarioId") REFERENCES "Usuario" ("Id") ON DELETE CASCADE,&#xD;
