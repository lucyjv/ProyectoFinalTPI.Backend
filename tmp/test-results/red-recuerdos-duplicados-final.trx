      CREATE TABLE momentos (&#xD;
          "Id" integer GENERATED BY DEFAULT AS IDENTITY,&#xD;
          "Nombre" character varying(200) NOT NULL,&#xD;
          "Descripcion" character varying(2000) NOT NULL,&#xD;
          "FechaInicio" date,&#xD;
          "FechaFin" date,&#xD;
          "FechaCreacion" timestamp with time zone NOT NULL,&#xD;
          "MomentoPadreId" integer,&#xD;
          CONSTRAINT "PK_momentos" PRIMARY KEY ("Id"),&#xD;
          CONSTRAINT "CK_momentos_fechas" CHECK ("FechaInicio" IS NULL OR "FechaFin" IS NULL OR "FechaFin" &gt;= "FechaInicio"),&#xD;
          CONSTRAINT "CK_momentos_nombre" CHECK (length(btrim("Nombre")) &gt; 0),&#xD;
          CONSTRAINT "CK_momentos_padre_distinto" CHECK ("MomentoPadreId" IS NULL OR "MomentoPadreId" &lt;&gt; "Id"),&#xD;
          CONSTRAINT "FK_momentos_momentos_MomentoPadreId" FOREIGN KEY ("MomentoPadreId") REFERENCES momentos ("Id") ON DELETE RESTRICT&#xD;
