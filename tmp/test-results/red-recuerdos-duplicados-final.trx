      CREATE TABLE momentos_alias (&#xD;
          "Id" integer GENERATED BY DEFAULT AS IDENTITY,&#xD;
          "MomentoId" integer NOT NULL,&#xD;
          "Texto" character varying(200) NOT NULL,&#xD;
          "TextoNormalizado" character varying(200) NOT NULL,&#xD;
          CONSTRAINT "PK_momentos_alias" PRIMARY KEY ("Id"),&#xD;
          CONSTRAINT "CK_momentos_alias_texto" CHECK (length(btrim("Texto")) &gt; 0 AND length(btrim("TextoNormalizado")) &gt; 0),&#xD;
          CONSTRAINT "FK_momentos_alias_momentos_MomentoId" FOREIGN KEY ("MomentoId") REFERENCES momentos ("Id") ON DELETE CASCADE&#xD;
      );&#xD;
